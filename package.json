{
  "name": "callsage",
  "version": "1.0.0",
  "description": "CallSage – Offline desktop call transcription and summarization app built with Electron + React",
  "main": "main.js",
  "scripts": {
    "setup-whisper": "node scripts/setup-whisper.js",
    "start": "webpack --mode development && electron .",
    "dev": "concurrently \"webpack --mode development --watch\" \"electron .\"",
    "build:renderer": "webpack --mode production",
    "build": "npm run setup-whisper && npm run build:renderer && electron-builder",
    "pack": "npm run setup-whisper && npm run build:renderer && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps && npm run setup-whisper"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "electron": "^26.6.10",
    "electron-builder": "^24.6.4",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.callsage.app",
    "productName": "CallSage",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "whisper/",
        "to": "whisper/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
